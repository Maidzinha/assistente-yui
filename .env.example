# Licenciamento da Yui (Maidzinha License Manager). Copie para .env.local e preencha.
# O .env.local não vai para o Git (está no .gitignore).

# Endereço da API de validação (aba "API / Validação" do License Manager).
MAIN_VITE_LICENSE_SERVER=http://127.0.0.1:8765
# Identificador do aplicativo cadastrado no License Manager.
MAIN_VITE_LICENSE_APP_ID=ASSISTENTE-YUI
# Chave de API do aplicativo (License Manager → Aplicativos → Assistente Yui).
MAIN_VITE_LICENSE_API_KEY=
